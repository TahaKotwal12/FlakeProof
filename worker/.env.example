# Copy to .env. See docs/01-ARCHITECTURE.md ("Environment variables").

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# mock | docker | contree — mock needs no keys below and is the default for local dev.
EXECUTOR=mock

# Nebius Token Factory — inference (Nemotron) + Sandboxes (ConTree). Only needed for EXECUTOR=contree
# or real LLM calls; verify base URLs/model IDs against the current docs before setting them.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Sandboxes has its own base path under the same host — verified against
# contree_sdk's ContreeEndpoint.TOKEN_FACTORY_SANDBOXES constant, not the
# inference API path above. Needs a key with Sandboxes permissions granted
# (separate from inference access — an inference-only key authenticates but
# gets 403 "Insufficient permissions" on every Sandboxes call).
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes/
NEMOTRON_FAST_MODEL=
NEMOTRON_SMART_MODEL=

# Optional; features degrade gracefully when unset.
TAVILY_API_KEY=
GITHUB_TOKEN=

MAX_CONCURRENT_SANDBOXES=10
MAX_ACTIVE_RUNS=2
