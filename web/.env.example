# Copy to .env.local and fill in. See docs/01-ARCHITECTURE.md ("Environment variables").

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: server-side only (used by route handlers under app/api).
# Never expose this to the browser / never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

APP_BASE_URL=http://127.0.0.1:4310
